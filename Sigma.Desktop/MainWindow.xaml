<Window x:Class="Sigma.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Kalkulation" Height="900" Width="1500" MinHeight="650" MinWidth="980" Background="#E8EBEB" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Teal" Color="#507B75"/>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4,2"/><Setter Property="Background" Value="#F7F8F8"/><Setter Property="BorderBrush" Value="#BEC9C7"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="6"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource Teal}" Padding="12,7"><DockPanel><TextBlock DockPanel.Dock="Right" Text="Selvstændig kalkulation" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="▣  Åbn  Gem  Udskriv" Foreground="White"/></DockPanel></Border>
        <TabControl Grid.Row="1" Background="#E2E5E5" SelectedIndex="3">
            <TabItem Header="Filer"><StackPanel Orientation="Horizontal"><Button Content="Ny" Click="NewEstimate"/><Button Content="Åbn kalkulation" Click="OpenEstimate"/><Button Content="Gem kalkulation" Click="SaveEstimate"/><Button Content="Importer Sigma .sit" Click="ImportSigma"/></StackPanel></TabItem>
            <TabItem Header="Hjem"><TextBlock Text="Redigér kalkulationslinjer i panelet nedenfor." Padding="12"/></TabItem>
            <TabItem Header="Vis"><TextBlock Text="Biblioteker og kalkulation vises samtidigt." Padding="12"/></TabItem>
            <TabItem Header="Biblioteker"><StackPanel Orientation="Horizontal"><Button Content="Åbn Sigma-bibliotek (.sli)" Click="OpenLibrary"/><Button Content="Kopiér valgt post til kalkulation" Click="CopyLibraryItem"/></StackPanel></TabItem>
            <TabItem Header="Rapporter"><TextBlock Text="Rapporter er endnu ikke implementeret." Padding="12"/></TabItem>
            <TabItem Header="Data"><TextBlock Text="Datafunktioner er endnu ikke implementeret." Padding="12"/></TabItem>
            <TabItem Header="Værktøjer"><TextBlock Text="Værktøjer er endnu ikke implementeret." Padding="12"/></TabItem>
            <TabItem Header="Hjælp"><TextBlock Text="Åbn .sli-bibliotek, vælg post, og kopiér den til kalkulationen." Padding="12"/></TabItem>
        </TabControl>
        <Border Grid.Row="2" Margin="5,5,5,0" BorderBrush="#ABB8B8" BorderThickness="1" Background="White">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#F0F1F1" Padding="9,5"><TextBlock Text="Biblioteker" FontWeight="SemiBold" Foreground="#52736F"/></Border>
                <TabControl x:Name="LibraryTabs" Background="White"/>
            </DockPanel>
        </Border>
        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" Background="#BFC9C8" ResizeDirection="Rows"/>
        <Border Grid.Row="4" Margin="5,0,5,5" BorderBrush="#ABB8B8" BorderThickness="1" Background="White">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#F0F1F1" Padding="8,5"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Tilføj linje" Click="AddLine"/><Button Content="Slet valgt linje" Click="RemoveLine"/><Button Content="Gem" Click="SaveEstimate"/></StackPanel><TextBlock Text="Kalkulation" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel></Border>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="#CCD3D3" BorderThickness="0,0,1,0" Padding="10"><StackPanel><TextBlock Text="Tilbudsliste" FontWeight="SemiBold"/><TextBox x:Name="EstimateName" Margin="0,8,0,0" TextChanged="NameChanged"/><TextBlock x:Name="SourceInfo" Foreground="#627574" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
                    <DockPanel Grid.Column="1"><Border DockPanel.Dock="Top" Background="{StaticResource Teal}" Padding="12,6"><TextBlock Text="Tilbudsliste" Foreground="White" FontSize="16" FontWeight="SemiBold"/></Border>
                        <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CellEditEnding="LineEdited" RowEditEnding="RowEdited" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="All" RowHeight="30" Background="White" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Position" Binding="{Binding Position, UpdateSourceTrigger=PropertyChanged}" Width="95"/>
                                <DataGridTextColumn Header="Tekst" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="Enhed" Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                                <DataGridTextColumn Header="Mængde" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                <DataGridTextColumn Header="Enhedspris" Binding="{Binding CostUnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                                <DataGridTextColumn Header="Samlet KP" Binding="{Binding TotalCost, StringFormat=N2}" IsReadOnly="True" Width="110"/>
                                <DataGridTextColumn Header="Salgs EP" Binding="{Binding SalesUnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                                <DataGridTextColumn Header="Salgspris" Binding="{Binding TotalSales, StringFormat=N2}" IsReadOnly="True" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>
        <Border Grid.Row="5" Background="#E1E5E4" Padding="12,5"><DockPanel><TextBlock x:Name="Totals" DockPanel.Dock="Right" FontWeight="SemiBold"/><TextBlock Text="Eget format (.skalk) · Sigma-formler og ressourcer er ikke implementeret" Foreground="#536967"/></DockPanel></Border>
    </Grid>
</Window>
